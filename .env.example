# Copy to .env.local for local development. .env.local is gitignored.
# Base URL of the FastAPI backend (see ../backend/README.md). Do not include
# the I07 router's own /v1/i7 prefix here -- src/features/initiative-7/
# services/i7-api.ts adds that itself, since it is specific to I07's router
# (see app/api/i7/router.py), not every backend route (e.g. GET /health).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Which recommendation dataset Initiative 7 (and only Initiative 7 today)
# renders: "scenario" (default) uses the hand-authored fixtures; "generated"
# uses the offline-built SAP-shaped dataset (npm run dataset:build); "live"
# fetches from the real backend above via services/i7-api.ts -- see
# src/lib/sap/dataset-mode.ts for what each mode does and does not resolve
# (in particular: material/plant identity does not map between the app's own
# fixtures and SAP in "live" mode either, same as "generated").
# NEXT_PUBLIC_DATASET=live
