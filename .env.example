# Copy to .env.local for local development. .env.local is gitignored.

# Base URL of the FastAPI backend (see ../Init-7-8-13-Backend/README.md). Do not include
# the I07 router's own /v1/i7 prefix here -- src/features/initiative-7/
# services/i7-api.ts adds that itself, since it is specific to I07's router
# (see app/api/i7/router.py), not every backend route (e.g. GET /health).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Multi-material requests (/assistant/requests): shows the menu entry and the
# assistant page's link. Switch on together with the backend's
# ASSISTANT_REQUESTS_ENABLED; until that is on, the screens say they are not
# enabled. See src/lib/assistant/request/flag.ts.
# NEXT_PUBLIC_ASSISTANT_REQUESTS=true

# With requests on, a single material is a request with one line: the landing
# page and the SAP BAdI link (/assistant/new) open the request screen. Set this
# to bring the step-by-step chat back for a single material.
# NEXT_PUBLIC_ASSISTANT_CHAT=true

# How long a GET may take before the page shows "the backend did not respond",
# in milliseconds. Default 60000; App Service cuts any request at 230 s.
#
# NEXT_PUBLIC_API_GET_TIMEOUT_MS=60000

# Who the backend records as the author of everything this app writes.
#
# Sent as the X-Actor-Id header on every request. The backend takes the author
# from that header and never from a request body, so identity is not simply
# whatever a payload claims (app/api/i13/deps.py::get_current_actor).
#
# This matters more than a normal dev setting: the assistant writes to five
# APPEND-ONLY tables -- sessions, turns, justifications, consumption plans,
# quantity suggestions -- where database triggers block UPDATE and DELETE. The
# name on a row is the name it carries forever.
#
# Unset defaults to UNAUTHENTICATED-FRONTEND, which is deliberately loud. Set it
# to walk two sessions through the assistant as two different people while
# there is no sign-in. Do NOT set it to a real colleague's name: a row stamped
# with somebody who did not make the decision is a false audit record, which is
# worse than an obviously provisional one.
#
# Retires when Entra lands -- see lib/api/actor.ts.
#
# NEXT_PUBLIC_ACTOR_ID=MILLERJ

# ---------------------------------------------------------------------------
# Sign-in (src/auth.ts, src/lib/auth/*). RUNTIME settings: on Azure they are
# App Service application settings on the web app, NOT build variables, so
# switching AUTH_MODE back to mock is the rollback and needs no redeploy.
# ---------------------------------------------------------------------------

# mock (default): the test sign-in -- any listed username, any password.
# entra: "Sign in with Microsoft" against VZI's Entra ID; every backend call then
# carries the user's access token (switch the backend's AUTH_ENABLED on too).
# AUTH_MODE=mock

# Required when AUTH_MODE=entra -- the login page names any that are missing.
# AUTH_SECRET=                       # random 32 bytes, e.g. `npx auth secret`; encrypts the session cookie
# AUTH_MICROSOFT_ENTRA_ID_ID=        # Application (client) ID of spares-ai-web-<env>
# AUTH_MICROSOFT_ENTRA_ID_SECRET=    # its client secret
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
# AUTH_API_SCOPE=api://<spares-ai-api-<env> client id>/access_as_user
# AUTH_TRUST_HOST=true               # behind Azure's front end (also set in code)
