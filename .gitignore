# Frontend-scoped ignores for the Next.js application.
#
# The repository-root .gitignore already covers everything here: its patterns
# are deliberately de-anchored so they match at any depth (see
# docs/repository-structure.md, "The 2026-09-09 restructure"). This file is the
# conventional per-app copy — keep the two consistent, and prefer the root file
# for anything that should apply to backend/ and data-generator/ as well.

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build output ---
/.next/
/out/
/build
next-env.d.ts

# --- Testing / coverage ---
/coverage

# --- TypeScript ---
*.tsbuildinfo

# --- Environment files ---
# Real env files are never committed; the template is.
.env
.env.*
!.env.example

# --- Deployment ---
.vercel

# --- Logs and OS noise ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
*.pem

# --- Archives ---
# An archive can carry files every rule above would have excluded -- a handover
# zip of this folder contains .env, credentials and all. Because git sees only
# the archive, no .env rule can help. So they are ignored by default; use -f
# deliberately if you ever need to track one.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# --- Local dev convenience scripts ---
# Machine-specific launcher (Docker Desktop + backend + frontend). Never shared.
start-dev.bat

# --- Demo-mode raw recordings (scripts/mock-data/record.mts) ---
# Large and one file per request; only src/mocks/demo-dataset.json is committed.
/.mock-recordings/
